--==================================================
-- 3. FORMATTERS
--==================================================

local function FormatNumber(value)
    if type(value) ~= "number" then
        return "--"
    end

    local absValue = math.abs(value)
    local suffix = ""

    if absValue >= 1e12 then
        value = value / 1e12
        suffix = "T"
    elseif absValue >= 1e9 then
        value = value / 1e9
        suffix = "B"
    elseif absValue >= 1e6 then
        value = value / 1e6
        suffix = "M"
    elseif absValue >= 1e3 then
        value = value / 1e3
        suffix = "K"
    else
        return tostring(math.floor(value))
    end

    return string.format("%.2f%s", value, suffix)
end

local function FormatTime(seconds)
    seconds = math.max(0, math.floor(seconds))

    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60

    return string.format("%02d:%02d:%02d", hours, minutes, secs)
end

local function DisplayValue(value)
    if value == nil then
        return "--"
    end

    return tostring(value)
end

--==================================================
-- 4. LOAD PS99 SAVE MODULE
--==================================================

local SaveModule

task.spawn(function()
    pcall(function()
        local library = ReplicatedStorage:WaitForChild("Library", 10)
        if not library then
            return
        end

        local client = library:WaitForChild("Client", 10)
        if not client then
            return
        end

        local save = client:WaitForChild("Save", 10)
        if not save then
            return
        end

        SaveModule = require(save)
    end)
end)

local function GetPlayerData()
    if not SaveModule then
        return nil
    end

    local ok, data = pcall(function()
        return SaveModule.Get()
    end)

    if ok and type(data) == "table" then
        return data
    end

    return nil
end

--==================================================
-- 5. DATA HELPERS
--==================================================

local function FindCurrency(data, aliases)
    local inventory = data and data.Inventory
    local currencies = inventory and inventory.Currency

    if type(currencies) ~= "table" then
        return nil
    end

    for _, currency in pairs(currencies) do
        if type(currency) == "table" and type(currency.id) == "string" then
            for _, alias in ipairs(aliases) do
                if currency.id:lower() == alias:lower() then
                    local amount = currency._am

                    if type(amount) == "number" then
                        return amount
                    end
                end
            end
        end
    end

    return nil
end

local function ReadNumber(data, keys)
    for _, key in ipairs(keys) do
        local value = data[key]

        if type(value) == "number" then
            return value
        end
    end

    return nil
end

