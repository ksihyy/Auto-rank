--==================================================
-- 8. DRAGGING: MOUSE + TOUCH
--==================================================

local dragging = false
local dragInput
local dragStart
local startPosition

Panel.InputBegan:Connect(function(input)
    local inputType = input.UserInputType

    if inputType == Enum.UserInputType.MouseButton1
        or inputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = Panel.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

Panel.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input == dragInput
        or input.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local delta = input.Position - dragStart

        Panel.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

--==================================================
-- 9. REAL-TIME DATA UPDATE
--==================================================

local function UpdateDashboard()
    local elapsed = os.clock() - StartClock
    TimerLabel.Text = FormatTime(elapsed)

    local data = GetPlayerData()

    if not data then
        HatchingLabel.Text = "Hatching: Waiting for game data"
        return
    end

    -- Gems and Fantasy Bars
    local gems = FindCurrency(data, {
        "Diamonds",
        "Gems",
    })

    local bars = FindCurrency(data, {
        "Fantasy Bars",
        "FantasyBars",
        "Bars",
        "Fantasy Coins",
    })

    if gems ~= nil then
        CurrentGems = gems

        if InitialGems == nil then
            InitialGems = gems
        end

        if elapsed > 0 then
            GemsPerMinute = ((gems - InitialGems) / elapsed) * 60
        end
    end

    if bars ~= nil then
        CurrentBars = bars
    end

    CurrencyLabel.Text = string.format(
        "Fantasy Bars: %s | Gems: %s",
        FormatNumber(CurrentBars),
        FormatNumber(CurrentGems)
    )

    RateLabel.Text = "Gems/Min: " ..
        FormatNumber(GemsPerMinute)

    -- Progression
    CurrentZone = ReadNumber(data, {
        "MaxZoneCmd",
        "MaxZone",
        "Zone",
    })

    CurrentRebirth = ReadNumber(data, {
        "Rebirths",
        "Rebirth",
    })

    CurrentRank = ReadNumber(data, {
        "Rank",
    })

    CurrentStars = ReadNumber(data, {
        "Stars",
    })

    CurrentMaxStars = ReadNumber(data, {
        "MaxStars",
    })

    ProgressLabel.Text = string.format(
        "Zone: %s | Rebirth: %s | Rank: %s",
        DisplayValue(CurrentZone),
        DisplayValue(CurrentRebirth),
        DisplayValue(CurrentRank)
    )

    StarsLabel.Text = string.format(
        "Stars: %s/%s",
        DisplayValue(CurrentStars),
        DisplayValue(CurrentMaxStars)
    )

    -- Total hatched eggs and session difference
    CurrentEggs = ReadNumber(data, {
        "EggsHatched",
    })

    if CurrentEggs ~= nil then
        if InitialEggs == nil then
            InitialEggs = CurrentEggs
        end

        local sessionEggs = math.max(0, CurrentEggs - InitialEggs)

        EggsLabel.Text = string.format(
            "Hatched Eggs: %s (+%s)",
            FormatNumber(CurrentEggs),
            FormatNumber(sessionEggs)
        )
    else
        EggsLabel.Text = "Hatched Eggs: -- (+--)"
    end

    -- Hatching status: display only a value actually present in the save
    local eggHatching = data.EggHatching

    if eggHatching ~= nil and eggHatching ~= false then
        if type(eggHatching) == "string" then
            CurrentHatching = eggHatching
        else
            CurrentHatching = tostring(eggHatching)
        end

        HatchingLabel.Text = "Hatching: " .. CurrentHatching
    else
        HatchingLabel.Text = "Hatching: Status unavailable"
    end
end

-- Update loop
task.spawn(function()
    while Running and ScreenGui.Parent do
        local ok, err = pcall(UpdateDashboard)

        if not ok then
            warn("[ThiLa Stats] Update error:", err)
        end

        task.wait(1)
    end
end)

--==================================================
-- 10. RIGHT CTRL: TOGGLE BLACK SCREEN + 3D
--==================================================

local renderingDisabled = false

local function Set3DRendering(enabled)
    pcall(function()
        RunService:Set3dRenderingEnabled(enabled)
    end)
end

-- Start with black overlay and disabled 3D rendering
Set3DRendering(false)
renderingDisabled = true

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode ~= Enum.KeyCode.RightControl then
        return
    end

    if gameProcessed then
        return
    end

    local visible = not Background.Visible
    Background.Visible = visible

    if visible then
        Set3DRendering(false)
        renderingDisabled = true
    else
        Set3DRendering(true)
        renderingDisabled = false
    end
end)

--==================================================
-- 11. CLEANUP
--==================================================

ScreenGui.Destroying:Connect(function()
    Running = false

    if renderingDisabled then
        Set3DRendering(true)
    end
end)

